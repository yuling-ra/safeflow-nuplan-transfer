  </joint>

  <!-- ======================= link8 (flange spacer) ======================= -->
  <link name="panda_link8">
    <inertial>
      <mass value="0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="panda_joint8" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.107"/>
    <parent link="panda_link7"/>
    <child link="panda_link8"/>
  </joint>

  <!-- ======================= NEW: tool stick installed on panda_link8 ======================= -->
  <!-- Parameters: length L=0.20 m, radius R=0.01 m, density ~1200 kg/m^3 -->
  <!-- Mass ~0.075398 kg; Inertia at COM (aligned with +Z): 
       Ixx = Iyy ≈ 2.5321236787933745e-04,  Izz ≈ 3.7699111843077525e-06 -->
  <link name="panda_tool">
    <visual>
      <!-- put cylinder center at L/2 so base aligns to flange (z=0) -->
      <origin xyz="0 0 0.00" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.10"/>
      </geometry>
      <!-- optional: simple color -->
      <!-- <material name="tool_color"><color rgba="0.1 0.7 0.9 1"/></material> -->
    </visual>
    <collision>
      <origin xyz="0 0 0.00" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <!-- COM at cylinder center -->
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="0.07539822368615505"/>
      <inertia ixx="0.00025321236787933745" ixy="0" ixz="0"
               iyy="0.00025321236787933745" iyz="0" izz="0.0000037699111843077525"/>
    </inertial>
  </link>

  <joint name="panda_tool_joint" type="fixed">
    <!-- align with flange; no -45° rotation like the original hand -->
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="panda_link8"/>
    <child link="panda_tool"/>
  </joint>

  <!-- A TCP frame at the tip of the stick (massless) -->
  <link name="panda_tool_tip">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <joint name="panda_tool_tip_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.10"/>
    <parent link="panda_tool"/>
    <child link="panda_tool_tip"/>
  </joint>

  <!-- ======================= (Removed) original hand & fingers ======================= -->
  <!-- Removed: panda_hand, panda_hand_tcp, panda_leftfinger, panda_rightfinger, 
       panda_hand_joint, panda_finger_joint1, panda_finger_joint2 -->

</robot>

